---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import { href } from '../lib/paths';
---
<Base>
  <section class="hero">
    <h1>¿Qué proyectos de ley llegan a las noticias?</h1>
    <SearchBox />
    <div class="browse">
      <a class="btn browse__btn" href={href('expedientes/')}>Por expediente</a>
      <a class="btn browse__btn" href={href('noticias/')}>Por noticia</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    max-width: 720px;
    margin: 0 auto;
    min-height: 62vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 3rem 0;
  }
  .hero h1 {
    font-size: clamp(1.9rem, 5.5vw, 2.9rem);
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .browse { display: flex; justify-content: center; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap; }
  .browse__btn { min-width: 10rem; justify-content: center; padding: 0.65em 1.2em; }
</style>
