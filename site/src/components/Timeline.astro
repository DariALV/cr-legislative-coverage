---
/**
 * Main visual: weekly news coverage during the study period with the bill's
 * procedural events (steps and votes) overlaid, plus an overview strip of the
 * whole procedure. Rendered as static SVG at build time (no client JS).
 */
import { STUDY_PERIOD } from '../lib/config';
import { formatDate, fromDayNumber, monthShort, toDayNumber, dateParts } from '../lib/format';
import type { BillNewsLink, BillStep, Vote } from '../lib/types';

interface Props {
  dateProposed: string;
  steps: BillStep[];
  votes: Vote[];
  news: BillNewsLink[];
}
const { dateProposed, steps, votes, news } = Astro.props;

const PS = toDayNumber(STUDY_PERIOD.start);
const PE = toDayNumber(STUDY_PERIOD.end);
const inPeriod = (d: number) => d >= PS && d <= PE;

/* ---- weekly buckets (weeks start on Monday) ---- */
const dow = (d: number) => (d + 3) % 7; // day 0 (1970-01-01) was a Thursday
const w0 = PS - dow(PS);
const nWeeks = Math.floor((PE - w0) / 7) + 1;
const weeks = Array.from({ length: nWeeks }, (_, i) => ({ start: w0 + i * 7, count: 0 }));
for (const n of news) {
  const d = toDayNumber(n.date_published);
  if (!inPeriod(d)) continue;
  weeks[Math.floor((d - w0) / 7)].count++;
}
const maxCount = Math.max(0, ...weeks.map((w) => w.count));

/* ---- events ---- */
type Ev = { day: number; date: string; kind: 'step' | 'vote'; title: string; detail: string; open: boolean };
const events: Ev[] = [
  ...steps.map((s) => ({
    day: toDayNumber(s.date_start), date: s.date_start, kind: 'step' as const,
    title: s.organ, detail: s.description, open: s.date_end === null,
  })),
  ...votes.map((v) => ({
    day: toDayNumber(v.date), date: v.date, kind: 'vote' as const,
    title: `Votación (${v.kind}): ${v.name}`, detail: v.result, open: false,
  })),
].sort((a, b) => a.day - b.day || (a.kind === 'vote' ? 1 : -1));
const numbered = events.map((e, i) => ({ ...e, n: i + 1 }));

/* ---- chart geometry: news above the axis, procedure events below it ---- */
const W = 760;
const M = { l: 12, r: 12, t: 18 };
const BARS_H = 84;
const AXIS_Y = M.t + BARS_H;
const MARKER_Y = [AXIS_Y + 44, AXIS_Y + 66];
const iw = W - M.l - M.r;
const span = nWeeks * 7;
const x = (d: number) => M.l + ((d - w0) / span) * iw;
const band = iw / nWeeks;
const barW = Math.min(8, band - 2);
const y = (v: number) => AXIS_Y - 4 - (v / Math.max(1, maxCount)) * (BARS_H - 4);

const months: { day: number; label: string }[] = [];
{
  const { y: ys, m: ms } = dateParts(STUDY_PERIOD.start);
  for (let yy = ys, mm = ms; ; mm++) {
    if (mm > 12) { mm = 1; yy++; }
    const d = toDayNumber(`${yy}-${String(mm).padStart(2, '0')}-01`);
    if (d > PE) break;
    months.push({ day: d, label: monthShort(mm) });
  }
}

// Markers for events inside the period. Events that fall on (almost) the same
// spot share one marker ("3–6"); neighbouring markers alternate between two rows.
const markers: { label: string; kind: Ev['kind']; cx: number; row: number; w: number; title: string }[] = [];
{
  const clusters: (typeof numbered)[] = [];
  for (const e of numbered.filter((e) => inPeriod(e.day))) {
    const last = clusters.at(-1);
    if (last && x(e.day + 0.5) - x(last[0].day + 0.5) < 14) last.push(e);
    else clusters.push([e]);
  }
  for (const c of clusters) {
    const cx = (x(c[0].day + 0.5) + x(c.at(-1)!.day + 0.5)) / 2;
    const label = c.length === 1 ? String(c[0].n) : `${c[0].n}–${c.at(-1)!.n}`;
    const w = Math.max(16, label.length * 6 + 8);
    const prev = markers.at(-1);
    const row = prev && cx - prev.cx < (w + prev.w) / 2 + 4 ? (prev.row + 1) % 2 : 0;
    markers.push({
      label, cx, row, w,
      kind: c.some((e) => e.kind === 'vote') ? 'vote' : 'step',
      title: c.map((e) => `${e.n}. ${formatDate(e.date)} · ${e.title}`).join('\n'),
    });
  }
}
const markerRows = markers.length ? Math.max(...markers.map((m) => m.row)) + 1 : 0;
const H = markerRows ? MARKER_Y[markerRows - 1] + 14 : AXIS_Y + 26;

/* ---- overview strip (whole procedure) ---- */
const proposedDay = toDayNumber(dateProposed);
const lastDay = Math.max(PE, ...steps.map((s) => toDayNumber(s.date_end ?? s.date_start)));
const OW = 760, OH = 64, OM = { l: 34, r: 12 };
const ox = (d: number) => OM.l + ((d - proposedDay) / Math.max(1, lastDay - proposedDay)) * (OW - OM.l - OM.r);
// Start of the study period: a single tick. Not drawn when the bill was filed after that start.
const showPeriodTick = PS >= proposedDay;
const periodX = Math.min(OW - OM.r, ox(PS));
const periodLabelEnd = periodX > OW - 190;
const segments = steps.map((s, i) => {
  const a = toDayNumber(s.date_start);
  const b = s.date_end ? toDayNumber(s.date_end) : PE;
  const x0 = ox(a), x1 = Math.max(ox(b), x0 + 3);
  return { x: x0 + 1, w: Math.max(2, x1 - x0 - 2), open: s.date_end === null, i, title: `${s.organ}: ${formatDate(s.date_start)} – ${s.date_end ? formatDate(s.date_end) : 'en curso'}` };
});
const years: { x: number; label: string }[] = [];
for (let yy = dateParts(dateProposed).y + 1; ; yy++) {
  const d = toDayNumber(`${yy}-01-01`);
  if (d > lastDay) break;
  years.push({ x: ox(d), label: String(yy) });
}
const totalInPeriod = weeks.reduce((a, w) => a + w.count, 0);
---
<figure class="timeline">
  <figcaption>
    <strong>Noticias por semana</strong>
    <span class="muted small">{formatDate(STUDY_PERIOD.start)} – {formatDate(STUDY_PERIOD.end)}</span>
    <span class="legend">
      <span><svg width="6" height="12" aria-hidden="true"><rect width="6" height="12" rx="3" fill="var(--s-news)"/></svg> Noticias vinculadas</span>
      <span><svg width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="5.5" fill="var(--surface)" stroke="var(--text-2)" stroke-width="1.5"/></svg> Paso del trámite</span>
      <span><svg width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="6" fill="var(--s-contra)"/></svg> Votación</span>
    </span>
  </figcaption>

  <svg class="chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Línea de tiempo: ${totalInPeriod} noticias vinculadas en el período, por semana, sobre el eje; ${markers.length} marcas de eventos del trámite, bajo el eje.`}>
    {weeks.map((w, i) => {
      const cx = M.l + (i + 0.5) * band;
      return (
        <g class="wk">
          <title>Semana del {formatDate(fromDayNumber(w.start))}: {w.count} {w.count === 1 ? 'noticia' : 'noticias'}</title>
          <rect class="hit" x={M.l + i * band} y="0" width={band} height={AXIS_Y} fill="transparent" />
          {w.count > 0 && <rect class="bar" x={cx - barW / 2} y={y(w.count)} width={barW} height={AXIS_Y - 4 - y(w.count) + 0.01} rx={barW / 2} fill="var(--s-news)" />}
          {w.count > 0 && <text x={cx} y={y(w.count) - 5} text-anchor="middle" class="count">{w.count}</text>}
        </g>
      );
    })}
    {markers.map((m) => (
      <line x1={m.cx} x2={m.cx} y1={AXIS_Y} y2={MARKER_Y[m.row] - 9} stroke="var(--border)" stroke-width="1" />
    ))}
    <line x1={M.l} x2={W - M.r} y1={AXIS_Y} y2={AXIS_Y} stroke="var(--border)" stroke-width="1.5" />
    {months.map((m) => (
      <g>
        <circle cx={x(m.day)} cy={AXIS_Y} r="4" fill="var(--surface)" stroke="var(--text-2)" stroke-width="1.5" />
        <text x={x(m.day)} y={AXIS_Y + 18} text-anchor={x(m.day) < M.l + 12 ? 'start' : 'middle'} class="tick">{m.label}</text>
      </g>
    ))}
    {markers.map((m) => {
      const cy = MARKER_Y[m.row];
      return (
        <g class="marker">
          <title>{m.title}</title>
          <rect x={m.cx - m.w / 2} y={cy - 8} width={m.w} height="16" rx="8"
            fill={m.kind === 'vote' ? 'var(--s-contra)' : 'var(--surface)'}
            stroke={m.kind === 'vote' ? 'var(--s-contra)' : 'var(--text-2)'} stroke-width="1.5" />
          <text x={m.cx} y={cy + 3.5} text-anchor="middle" class={m.kind === 'vote' ? 'mk mk--vote' : 'mk'}>{m.label}</text>
        </g>
      );
    })}
    {totalInPeriod === 0 && (
      <text x={M.l + iw / 2} y={M.t + BARS_H / 2} text-anchor="middle" class="empty-label">Sin noticias vinculadas en el período</text>
    )}
  </svg>

  <div class="overview">
    <div class="overview__label small muted">Trámite completo, desde la presentación ({formatDate(dateProposed)})</div>
    <svg class="chart" viewBox={`0 0 ${OW} ${OH}`} role="img" aria-label="Duración de cada paso del trámite y ubicación del período de estudio.">
      {showPeriodTick && (
        <g>
          <line x1={periodX} x2={periodX} y1="6" y2="42" stroke="var(--muted)" stroke-width="1" stroke-dasharray="3 3" opacity="0.7" />
          <text x={periodLabelEnd ? periodX - 5 : periodX + 5} y="12" text-anchor={periodLabelEnd ? 'end' : 'start'} class="tick tick--faint">inicio del período de estudio</text>
        </g>
      )}
      {segments.map((s) => (
        <rect x={s.x} y="22" width={s.w} height="14" rx="3" fill={s.i % 2 ? 'var(--s-step-b)' : 'var(--s-step-a)'} opacity={s.open ? 0.55 : 1}>
          <title>{s.title}</title>
        </rect>
      ))}
      {votes.map((v) => {
        const vx = ox(toDayNumber(v.date));
        return <rect x={vx - 4} y="25" width="8" height="8" transform={`rotate(45 ${vx} 29)`} fill="var(--s-contra)" stroke="var(--surface)" stroke-width="1.5"><title>{v.name}: {formatDate(v.date)}</title></rect>;
      })}
      <line x1={OM.l} x2={OW - OM.r} y1="42" y2="42" stroke="var(--border)" />
      {years.map((yv) => (
        <g>
          <line x1={yv.x} x2={yv.x} y1="42" y2="47" stroke="var(--border)" />
          <text x={yv.x} y={OH - 4} text-anchor="middle" class="tick">{yv.label}</text>
        </g>
      ))}
    </svg>
  </div>

  {numbered.length > 0 && (
  <details class="events-view">
    <summary>Ver las fechas del trámite ({numbered.length} {numbered.length === 1 ? 'evento' : 'eventos'})</summary>
    <ol class="events">
    {numbered.map((e) => (
      <li class={inPeriod(e.day) ? 'in-period' : ''}>
        <span class={`num num--${e.kind}`} aria-hidden="true">{e.n}</span>
        <div>
          <div class="ev-head">
            <time datetime={e.date}>{formatDate(e.date)}</time>
            <strong>{e.title}</strong>
            {e.open && <span class="pill">en curso</span>}
          </div>
          <div class="small text-2 ev-detail">{e.detail}</div>
        </div>
      </li>
    ))}
    </ol>
  </details>
  )}

  <details class="table-view">
    <summary>Ver las cifras semanales como tabla</summary>
    <div class="table-wrap">
      <table class="data">
        <thead><tr><th>Semana del</th><th class="num">Noticias</th></tr></thead>
        <tbody>
          {weeks.map((w) => <tr><td>{formatDate(fromDayNumber(w.start))}</td><td class="num">{w.count}</td></tr>)}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .timeline { margin: 0; }
  figcaption { display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; align-items: baseline; font-size: 0.95rem; margin-bottom: 0.5rem; }
  .legend { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin-left: auto; font-size: 0.8rem; color: var(--text-2); }
  .legend span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .chart { display: block; width: 100%; height: auto; overflow: visible; }
  .tick { font-size: 11px; fill: var(--muted); }
  .tick--faint { font-size: 10px; opacity: 0.8; }
  .count { font-size: 10px; fill: var(--text-2); font-variant-numeric: tabular-nums; }
  .mk { font-size: 9.5px; font-weight: 700; fill: var(--text-2); }
  .mk--vote { fill: #fff; }
  .empty-label { font-size: 13px; fill: var(--muted); }
  .wk:hover .bar { filter: brightness(1.15); }
  .wk:hover .hit { fill: var(--grid); }
  .overview { margin-top: 0.75rem; }
  .events-view { margin-top: 1rem; }
  .events-view summary { cursor: pointer; }
  .events { list-style: none; margin: 1rem 0 0; padding: 0; }
  .events li { position: relative; display: flex; gap: 0.9rem; align-items: flex-start; padding-bottom: 1.15rem; line-height: 1.5; }
  .events li:last-child { padding-bottom: 0; }
  /* rail joining one event to the next */
  .events li:not(:last-child)::before { content: ''; position: absolute; left: 11px; top: 24px; bottom: 0; width: 1px; background: var(--border); }
  .num {
    flex: none; display: inline-grid; place-items: center; position: relative;
    width: 23px; height: 23px; border-radius: 50%;
    background: var(--surface); color: var(--text-2); border: 1px solid var(--border);
    font-size: 0.7rem; font-weight: 600;
  }
  .in-period .num { border-color: var(--text-2); }
  .num--vote { color: var(--s-contra); border-color: var(--s-contra); }
  .in-period .num--vote { background: var(--s-contra); color: #fff; }
  .ev-head { font-size: 0.95rem; }
  .ev-head time { display: block; color: var(--muted); font-size: 0.8rem; font-variant-numeric: tabular-nums; }
  .ev-head strong { font-weight: 600; }
  .ev-head .pill { margin-left: 0.4rem; }
  .ev-detail { margin-top: 0.15rem; max-width: 70ch; }
  .table-view { margin-top: 1rem; }
</style>
