---
/**
 * Main visual: weekly news coverage during the study period with the bill's
 * procedural events (steps and votes) overlaid, plus an overview strip of the
 * whole procedure. Rendered as static SVG at build time (no client JS).
 */
import { STUDY_PERIOD } from '../lib/config';
import { formatDate, fromDayNumber, monthShort, toDayNumber, dateParts } from '../lib/format';
import type { BillNewsLink, BillStep, Vote } from '../lib/types';

interface Props {
  dateProposed: string;
  steps: BillStep[];
  votes: Vote[];
  news: BillNewsLink[];
}
const { dateProposed, steps, votes, news } = Astro.props;

const PS = toDayNumber(STUDY_PERIOD.start);
const PE = toDayNumber(STUDY_PERIOD.end);
const inPeriod = (d: number) => d >= PS && d <= PE;

/* ---- weekly buckets (weeks start on Monday) ---- */
const dow = (d: number) => (d + 3) % 7; // day 0 (1970-01-01) was a Thursday
const w0 = PS - dow(PS);
const nWeeks = Math.floor((PE - w0) / 7) + 1;
const weeks = Array.from({ length: nWeeks }, (_, i) => ({ start: w0 + i * 7, count: 0 }));
for (const n of news) {
  const d = toDayNumber(n.date_published);
  if (!inPeriod(d)) continue;
  weeks[Math.floor((d - w0) / 7)].count++;
}
const maxCount = Math.max(0, ...weeks.map((w) => w.count));

/* ---- events ---- */
type Ev = { day: number; date: string; kind: 'step' | 'vote'; title: string; detail: string; open: boolean };
const events: Ev[] = [
  ...steps.map((s) => ({
    day: toDayNumber(s.date_start), date: s.date_start, kind: 'step' as const,
    title: s.organ, detail: s.description, open: s.date_end === null,
  })),
  ...votes.map((v) => ({
    day: toDayNumber(v.date), date: v.date, kind: 'vote' as const,
    title: `Votación (${v.kind}): ${v.name}`, detail: v.result, open: false,
  })),
].sort((a, b) => a.day - b.day || (a.kind === 'vote' ? 1 : -1));
const numbered = events.map((e, i) => ({ ...e, n: i + 1 }));

/* ---- chart geometry ---- */
const W = 760, H = 230;
const M = { l: 34, r: 12, t: 52, b: 28 };
const iw = W - M.l - M.r, ih = H - M.t - M.b;
const span = nWeeks * 7;
const x = (d: number) => M.l + ((d - w0) / span) * iw;
const band = iw / nWeeks;
const barW = Math.min(24, band - 2);

function niceStep(max: number) {
  for (const s of [1, 2, 5, 10, 20, 25, 50, 100, 200, 500]) if (max / s <= 4) return s;
  return 1000;
}
const step = niceStep(Math.max(1, maxCount));
const yMax = Math.max(step, Math.ceil(Math.max(1, maxCount) / step) * step);
const y = (v: number) => M.t + ih - (v / yMax) * ih;
const yTicks = Array.from({ length: yMax / step + 1 }, (_, i) => i * step);

function barPath(cx: number, v: number) {
  const x0 = cx - barW / 2, x1 = cx + barW / 2, yb = y(0), yt = y(v);
  const r = Math.min(4, yb - yt, barW / 2);
  return `M${x0},${yb}V${yt + r}Q${x0},${yt} ${x0 + r},${yt}H${x1 - r}Q${x1},${yt} ${x1},${yt + r}V${yb}Z`;
}

const months: { day: number; label: string }[] = [];
{
  const { y: ys, m: ms } = dateParts(STUDY_PERIOD.start);
  for (let yy = ys, mm = ms; ; mm++) {
    if (mm > 12) { mm = 1; yy++; }
    const d = toDayNumber(`${yy}-${String(mm).padStart(2, '0')}-01`);
    if (d > PE) break;
    months.push({ day: d, label: monthShort(mm) });
  }
}

// Markers for events inside the period; stagger when they collide.
const markers: { n: number; kind: Ev['kind']; cx: number; row: number; title: string }[] = [];
for (const e of numbered.filter((e) => inPeriod(e.day))) {
  const cx = x(e.day + 0.5);
  const prev = markers.filter((m) => Math.abs(m.cx - cx) < 20);
  const row = prev.length ? (Math.max(...prev.map((m) => m.row)) + 1) % 2 : 0;
  markers.push({ n: e.n, kind: e.kind, cx, row, title: `${e.n}. ${formatDate(e.date)} · ${e.title}` });
}

/* ---- overview strip (whole procedure) ---- */
const proposedDay = toDayNumber(dateProposed);
const lastDay = Math.max(PE, ...steps.map((s) => toDayNumber(s.date_end ?? s.date_start)));
const OW = 760, OH = 64, OM = { l: 34, r: 12 };
const ox = (d: number) => OM.l + ((d - proposedDay) / Math.max(1, lastDay - proposedDay)) * (OW - OM.l - OM.r);
const segments = steps.map((s, i) => {
  const a = toDayNumber(s.date_start);
  const b = s.date_end ? toDayNumber(s.date_end) : PE;
  const x0 = ox(a), x1 = Math.max(ox(b), x0 + 3);
  return { x: x0 + 1, w: Math.max(2, x1 - x0 - 2), open: s.date_end === null, i, title: `${s.organ}: ${formatDate(s.date_start)} – ${s.date_end ? formatDate(s.date_end) : 'en curso'}` };
});
const years: { x: number; label: string }[] = [];
for (let yy = dateParts(dateProposed).y + 1; ; yy++) {
  const d = toDayNumber(`${yy}-01-01`);
  if (d > lastDay) break;
  years.push({ x: ox(d), label: String(yy) });
}
const totalInPeriod = weeks.reduce((a, w) => a + w.count, 0);
---
<figure class="timeline">
  <figcaption>
    <strong>Noticias por semana</strong>
    <span class="muted"> · {formatDate(STUDY_PERIOD.start)} – {formatDate(STUDY_PERIOD.end)}</span>
    <span class="legend">
      <span><svg width="12" height="12" aria-hidden="true"><rect width="12" height="12" rx="2" fill="var(--s-news)"/></svg> Noticias vinculadas</span>
      <span><svg width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="6" fill="var(--text)"/></svg> Paso del trámite</span>
      <span><svg width="14" height="14" aria-hidden="true"><rect x="2.5" y="2.5" width="9" height="9" transform="rotate(45 7 7)" fill="var(--s-contra)"/></svg> Votación</span>
    </span>
  </figcaption>

  <svg class="chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Gráfico de barras: ${totalInPeriod} noticias vinculadas en el período, por semana, con ${markers.length} eventos del trámite marcados.`}>
    {yTicks.map((t) => (
      <g>
        <line x1={M.l} x2={W - M.r} y1={y(t)} y2={y(t)} stroke="var(--grid)" stroke-width="1" />
        <text x={M.l - 6} y={y(t) + 4} text-anchor="end" class="tick">{t}</text>
      </g>
    ))}
    {months.map((m) => (
      <g>
        <line x1={x(m.day)} x2={x(m.day)} y1={y(0)} y2={y(0) + 5} stroke="var(--border)" />
        <text x={x(m.day) + 3} y={H - 8} class="tick">{m.label}</text>
      </g>
    ))}
    {markers.map((m) => (
      <line x1={m.cx} x2={m.cx} y1={M.t - 14 - m.row * 22 + 8} y2={y(0)} stroke="var(--text-2)" stroke-width="1" opacity="0.55" />
    ))}
    {weeks.map((w, i) => (
      <g class="wk">
        <title>Semana del {formatDate(fromDayNumber(w.start))}: {w.count} {w.count === 1 ? 'noticia' : 'noticias'}</title>
        <rect x={M.l + i * band} y={M.t} width={band} height={ih} fill="transparent" />
        {w.count > 0 && <path class="bar" d={barPath(M.l + (i + 0.5) * band, w.count)} fill="var(--s-news)" />}
      </g>
    ))}
    <line x1={M.l} x2={W - M.r} y1={y(0)} y2={y(0)} stroke="var(--text-2)" stroke-width="1" />
    {markers.map((m) => {
      const cy = M.t - 14 - m.row * 22;
      return (
        <g class="marker">
          <title>{m.title}</title>
          {m.kind === 'vote'
            ? <rect x={m.cx - 8} y={cy - 8} width="16" height="16" transform={`rotate(45 ${m.cx} ${cy})`} fill="var(--s-contra)" stroke="var(--surface)" stroke-width="2" />
            : <circle cx={m.cx} cy={cy} r="9" fill="var(--text)" stroke="var(--surface)" stroke-width="2" />}
          <text x={m.cx} y={cy + 4} text-anchor="middle" class={m.kind === 'vote' ? 'mk mk--vote' : 'mk'}>{m.n}</text>
        </g>
      );
    })}
    {totalInPeriod === 0 && (
      <text x={M.l + iw / 2} y={M.t + ih / 2} text-anchor="middle" class="empty-label">Sin noticias vinculadas en el período</text>
    )}
  </svg>

  <div class="overview">
    <div class="overview__label small muted">Trámite completo, desde la presentación ({formatDate(dateProposed)})</div>
    <svg class="chart" viewBox={`0 0 ${OW} ${OH}`} role="img" aria-label="Duración de cada paso del trámite y ubicación del período de estudio.">
      <rect x={ox(PS)} y="4" width={Math.max(2, ox(PE) - ox(PS))} height={OH - 22} fill="var(--s-window)" rx="3" />
      <text x={ox(PE)} y="15" text-anchor="end" class="tick">período de estudio</text>
      {segments.map((s) => (
        <rect x={s.x} y="22" width={s.w} height="14" rx="3" fill={s.i % 2 ? 'var(--s-step-b)' : 'var(--s-step-a)'} opacity={s.open ? 0.55 : 1}>
          <title>{s.title}</title>
        </rect>
      ))}
      {votes.map((v) => {
        const vx = ox(toDayNumber(v.date));
        return <rect x={vx - 4} y="25" width="8" height="8" transform={`rotate(45 ${vx} 29)`} fill="var(--s-contra)" stroke="var(--surface)" stroke-width="1.5"><title>{v.name}: {formatDate(v.date)}</title></rect>;
      })}
      <line x1={OM.l} x2={OW - OM.r} y1="42" y2="42" stroke="var(--border)" />
      {years.map((yv) => (
        <g>
          <line x1={yv.x} x2={yv.x} y1="42" y2="47" stroke="var(--border)" />
          <text x={yv.x} y={OH - 4} text-anchor="middle" class="tick">{yv.label}</text>
        </g>
      ))}
    </svg>
  </div>

  <ol class="events">
    {numbered.map((e) => (
      <li class={inPeriod(e.day) ? 'in-period' : ''}>
        <span class={`num num--${e.kind}`} aria-hidden="true">{e.n}</span>
        <div>
          <div class="ev-head">
            <time datetime={e.date}>{formatDate(e.date)}</time>
            <strong>{e.title}</strong>
            {e.open && <span class="pill">en curso</span>}
          </div>
          <div class="small text-2">{e.detail}</div>
        </div>
      </li>
    ))}
  </ol>

  <details class="table-view">
    <summary>Ver las cifras semanales como tabla</summary>
    <div class="table-wrap">
      <table class="data">
        <thead><tr><th>Semana del</th><th class="num">Noticias</th></tr></thead>
        <tbody>
          {weeks.map((w) => <tr><td>{formatDate(fromDayNumber(w.start))}</td><td class="num">{w.count}</td></tr>)}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .timeline { margin: 0; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; }
  figcaption { display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; align-items: baseline; font-size: 0.95rem; margin-bottom: 0.5rem; }
  .legend { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; margin-left: auto; font-size: 0.8rem; color: var(--text-2); }
  .legend span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .chart { display: block; width: 100%; height: auto; overflow: visible; }
  .tick { font-size: 11px; fill: var(--muted); }
  .mk { font-size: 10px; font-weight: 700; fill: var(--surface); }
  .mk--vote { fill: #fff; }
  .empty-label { font-size: 13px; fill: var(--muted); }
  .wk:hover .bar { filter: brightness(1.15); }
  .wk:hover rect { fill: var(--s-window); }
  .overview { margin-top: 0.75rem; }
  .events { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.55rem; }
  .events li { display: flex; gap: 0.65rem; align-items: flex-start; }
  .events li:not(.in-period) { opacity: 0.8; }
  .num {
    flex: none; display: inline-grid; place-items: center;
    width: 22px; height: 22px; margin-top: 1px; border-radius: 50%;
    background: var(--surface-2); color: var(--text-2); border: 1px solid var(--border);
    font-size: 0.72rem; font-weight: 700;
  }
  .in-period .num--step { background: var(--text); color: var(--surface); border-color: var(--text); }
  .in-period .num--vote { background: var(--s-contra); color: #fff; border-color: var(--s-contra); }
  .num--vote { border-radius: 4px; }
  .ev-head { display: flex; flex-wrap: wrap; gap: 0.1rem 0.6rem; align-items: baseline; font-size: 0.92rem; }
  .ev-head time { color: var(--muted); font-variant-numeric: tabular-nums; min-width: 6.5em; }
  .table-view { margin-top: 1rem; }
</style>
