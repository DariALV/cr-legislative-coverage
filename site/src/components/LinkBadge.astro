---
/**
 * Shows where a news↔bill link comes from and how confident it is, plus
 * the "¿Este vínculo está mal?" report link when a report form is configured.
 */
import { describeLink, reportLinkUrl } from '../lib/links';
import type { LinkSource } from '../lib/types';

interface Props {
  source: LinkSource;
  confidence: number | null;
  billNumber: number;
  newsId: string;
}
const { source, confidence, billNumber, newsId } = Astro.props;
const d = describeLink(source, confidence);
const reportUrl = reportLinkUrl(billNumber, newsId);
---
<span class="link-badge">
  <span class={`src src--${source}`} title={d.sourceDescription}>
    {source === 'modelo' ? (
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path fill="currentColor" d="M8 1l1.6 3.9L14 5.5l-3.2 2.8.9 4.2L8 10.4l-3.7 2.1.9-4.2L2 5.5l4.4-.6z"/></svg>
    ) : (
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path fill="currentColor" d="M6.2 11.6 2.6 8l1.2-1.2 2.4 2.4 6-6L13.4 4.4z"/></svg>
    )}
    {d.sourceLabel}
  </span>
  {d.band && (
    <span class={`conf conf--${d.band.key}`} title={`Confianza del modelo: ${d.confidenceText} (escala 0 a 1)`}>
      <span class="meter" aria-hidden="true"><span style={`width:${Math.round((confidence ?? 0) * 100)}%`}></span></span>
      Confianza {d.band.label} <span class="mono">{d.confidenceText}</span>
    </span>
  )}
  {reportUrl && <a class="report" href={reportUrl} target="_blank" rel="noopener">¿Este vínculo está mal?</a>}
</span>

<style>
  .link-badge { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.6rem; font-size: 0.8rem; }
  .src, .conf {
    display: inline-flex; align-items: center; gap: 0.3em;
    padding: 0.05em 0.55em;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-2);
    background: var(--surface-2);
    white-space: nowrap;
  }
  .src--modelo { border-style: dashed; background: transparent; }
  .meter { display: inline-block; width: 32px; height: 6px; border-radius: 3px; background: var(--grid); overflow: hidden; }
  .meter > span { display: block; height: 100%; border-radius: 3px; background: var(--conf-medium); }
  .conf--high .meter > span { background: var(--conf-high); }
  .conf--low .meter > span { background: var(--muted); }
  .conf--low { border-style: dashed; }
  .report { color: var(--muted); font-size: 0.78rem; }
  .report:hover { color: var(--accent); }
</style>
