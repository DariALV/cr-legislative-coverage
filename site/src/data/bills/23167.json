{"bill":{"number":23167,"name":"COMISIÓN DE MODERNIZACIÓN Y REFORMA DEL ESTADO QUE TENDRÁ COMO META PROPICIAR UN MODELO DE ESTADO MODERNO Y ÁGIL, QUE OPTIMICE LOS RECURSOS ECONÓMICOS, HUMANOS Y TECNOLÓGICOS EN BENEFICIO DE LA CIUDADANÍA Y FORTALEZCA LA ESTRUCTURA DEMOCRÁTICA DE NUESTRA SOCIEDAD, ACORDE CON LAS DEMANDAS ACTUALES DE LA POBLACIÓN, DE TAL MANERA QUE PERMITA MEJORAR EL NIVEL DE VIDA DE LOS COSTARRICENSES. DICHA COMISIÓN TENDRÁ LA POTESTAD DE PROPONER Y DICTAMINAR INICIATIVAS DE LEY RELACIONADAS CON LA MODERNIZACIÓN Y OPTIMIZACIÓN DE LA ESTRUCTURA ADMINISTRATIVA DEL ESTADO, Y PROCURARÁ UN AMPLIA PARTICIPACIÓN DE LOS REPRESENTANTES DEL MINISTERIO DE PLANIFICACIÓN NACIONAL Y POLÍTICA ECONÓMICA","file_type":"PROCEDIMIENTO COMISIONES ESPECIALES INVESTIGADORAS","date_proposed":"2022-06-09","status":"Archivado","law_number":null,"subjects":["ESTADO","MODERNIZACION","BENEFICIO","CIUDADANIA","COMISION","DEMOCRATIC,-O/-A","ECONOMIC,-O/-A","ESTRUCTURA","HUMAN,-O/-A","MODELO","RECURSO","REFORMA","SOCIEDAD","TECNOLOGIC,-O/-A"],"proponents":[],"news_count":0,"votes_count":1,"motions_count":0},"proponents":[],"steps":[{"organ":"PLENARIO","description":"PRESENTACION DE LA MOCION","date_start":"2022-06-09","date_end":"2022-06-09"},{"organ":"PLENARIO","description":"VOTACIÓN DE LA MOCION","date_start":"2022-06-09","date_end":"2022-06-09"},{"organ":"PLENARIO","description":"INSTALACIÓN DE LA COMISIÓN ESPECIAL","date_start":"2022-06-22","date_end":"2022-06-22"},{"organ":"C.E. REFORMA ESTADO (ÁREA IV)","description":"INGRESO EN EL ORDEN DEL DÍA Y DEBATE (COMISIÓN)","date_start":"2022-07-01","date_end":"2026-04-09"},{"organ":"C.E. REFORMA ESTADO (ÁREA IV)","description":"ARCHIVO DEL EXPEDIENTE (Vencimiento Plazo Comisiones Especiales (Art.206)","date_start":"2026-05-06","date_end":"2026-05-06"},{"organ":"ARCHIVO","description":"ARCHIVO DEL EXPEDIENTE (Vencimiento Plazo Comisiones Especiales (Art.206)","date_start":"2026-05-06","date_end":"2026-05-06"},{"organ":"ARCHIVO","desc